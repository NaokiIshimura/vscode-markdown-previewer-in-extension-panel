{
  "name": "markdown-previewer-in-extension-panel",
  "publisher": "nacn",
  "displayName": "Markdown Preview in Extension Area",
  "description": "Display markdown preview in sidebar or panel",
  "version": "0.4.15",
  "icon": "assets/icon-128.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NaokiIshimura/vscode-markdown-previewer-in-extension-panel.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown Preview in Extension Area",
      "properties": {
        "markdownPreviewInExtensionPanel.defaultZoomLevel": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "Default zoom level for markdown preview (50-200%)"
        },
        "markdownPreviewInExtensionPanel.themeMode": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Theme mode for the Markdown preview. 'auto' syncs with the VS Code theme, 'light' always uses the light theme, and 'dark' always uses the dark theme.",
          "enumDescriptions": [
            "Automatically sync with the VS Code theme",
            "Always use the light theme",
            "Always use the dark theme"
          ]
        },
        "markdownPreviewInExtensionPanel.fileSortOrder": {
          "type": "string",
          "enum": [
            "name",
            "modified"
          ],
          "default": "name",
          "description": "Sort order for files in the sidebar Files tab.",
          "enumDescriptions": [
            "Sort files alphabetically by name",
            "Sort files by modification date (newest first)"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownPreviewContainer",
          "title": "Markdown",
          "icon": "$(markdown)"
        }
      ]
    },
    "views": {
      "markdownPreviewContainer": [
        {
          "id": "markdownPreview",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "markdownPreview.refresh",
        "title": "Refresh [r]",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownPreview.edit",
        "title": "Edit [e]",
        "icon": "$(edit)",
        "enablement": "markdownPreview:canEdit"
      },
      {
        "command": "markdownPreview.pin",
        "title": "Pin [p]",
        "icon": "$(pin)",
        "enablement": "markdownPreview:canPin"
      },
      {
        "command": "markdownPreview.unpin",
        "title": "Unpin [p]",
        "icon": "$(pinned)"
      },
      {
        "command": "markdownPreview.togglePin",
        "title": "Toggle Pin [p]"
      },
      {
        "command": "markdownPreview.useLightTheme",
        "title": "Use Light Theme [t]",
        "icon": "$(color-mode)"
      },
      {
        "command": "markdownPreview.useDarkTheme",
        "title": "Use Dark Theme [t]",
        "icon": "$(color-mode)"
      },
      {
        "command": "markdownPreview.zoomIn",
        "title": "Zoom In [+]",
        "icon": "$(zoom-in)"
      },
      {
        "command": "markdownPreview.zoomOut",
        "title": "Zoom Out [-]",
        "icon": "$(zoom-out)"
      },
      {
        "command": "markdownPreview.resetZoom",
        "title": "Reset Zoom [r]",
        "icon": "$(search-stop)"
      },
      {
        "command": "markdownPreview.openSettings",
        "title": "Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "markdownPreview.search",
        "title": "Search [f]",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "markdownPreview.pin",
          "when": "view == markdownPreview && markdownPreview:canPin && !markdownPreview:isPinned",
          "group": "navigation@0"
        },
        {
          "command": "markdownPreview.unpin",
          "when": "view == markdownPreview && markdownPreview:isPinned",
          "group": "navigation@0"
        },
        {
          "command": "markdownPreview.search",
          "when": "view == markdownPreview",
          "group": "navigation@1"
        },
        {
          "command": "markdownPreview.useDarkTheme",
          "when": "view == markdownPreview && !markdownPreview:isDarkTheme",
          "group": "navigation@2"
        },
        {
          "command": "markdownPreview.useLightTheme",
          "when": "view == markdownPreview && markdownPreview:isDarkTheme",
          "group": "navigation@2"
        },
        {
          "command": "markdownPreview.zoomIn",
          "when": "view == markdownPreview",
          "group": "navigation@3"
        },
        {
          "command": "markdownPreview.zoomOut",
          "when": "view == markdownPreview",
          "group": "navigation@4"
        },
        {
          "command": "markdownPreview.resetZoom",
          "when": "view == markdownPreview",
          "group": "navigation@5"
        },
        {
          "command": "markdownPreview.edit",
          "when": "view == markdownPreview && markdownPreview:canEdit",
          "group": "navigation@6"
        },
        {
          "command": "markdownPreview.refresh",
          "when": "view == markdownPreview",
          "group": "navigation@7"
        },
        {
          "command": "markdownPreview.openSettings",
          "when": "view == markdownPreview",
          "group": "navigation@8"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.view.extension.markdownPreviewContainer",
        "key": "cmd+shift+m",
        "mac": "cmd+shift+m",
        "win": "ctrl+shift+m",
        "linux": "ctrl+shift+m"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^13.0.1",
    "markdown-it-anchor": "^9.2.0"
  }
}